[sub_resource type="GDScript" id="GDScript_4s2hj"]
resource_name = "point_and_click_input"
script/source = "extends Node3D

@export var camera : Camera3D
@export var extra_ray_length : float = 100
@onready var ray_length : float = absf(global_position.y - camera.global_position.y) + extra_ray_length

@export var navigation_component : Node
var navigationEnabled : bool = false

var click : bool

signal on_world_click(position : Vector3)

func _ready() -> void:
	if navigation_component:
		if !navigation_component.has_method(\"navigate_to\"):
			printerr(\"Invalid Navigation Component\")
		else: navigationEnabled = true

func _input(_event: InputEvent) -> void:
	if Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT):
		if !click:
			var results : Array[Dictionary] = get_mousecast_3d()
			if results:
				var positions : Array[Vector3]
				for result : Dictionary in results:
					positions.append(result[\"position\"])
				positions.sort_custom(closest_height)
				on_world_click.emit(positions[0])
				if navigationEnabled:
					navigation_component.navigate_to(positions[0])
		click = true
	else :
		click = false

func get_mousecast_3d() -> Array[Dictionary]:
	var mouse_pos : Vector2 = get_viewport().get_mouse_position()
	var camera_origin : Vector3 = camera.project_ray_origin(mouse_pos)
	return raycast_all(camera_origin, camera_origin + camera.project_ray_normal(mouse_pos) * ray_length)

func raycast_all(from: Vector3, to: Vector3, exclude: Array[RID] = []) -> Array[Dictionary]:
	const MAX_COLLISIONS: int = 20
	var entities: Array[Dictionary] = []
	var world_state:  PhysicsDirectSpaceState3D = get_world_3d().get_direct_space_state()
	for i : int in MAX_COLLISIONS:
		var query : PhysicsRayQueryParameters3D = PhysicsRayQueryParameters3D.create(from, to)
		query.set_exclude(exclude)
		var result: Dictionary = world_state.intersect_ray(query)
		if result:
			entities.append(result)
			exclude.append(result.rid)
			from = result.position
		else:
			break
	return entities

func closest_height(a : Vector3, b : Vector3) -> bool:
	var deltaA : float = a.y - global_position.y
	var deltaB : float = b.y - global_position.y
	return absf(deltaA) < absf(deltaB)
"

